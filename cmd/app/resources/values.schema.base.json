{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "definitions": {
    "metachart.interface.FQDNitem": {
      "type": "string",
      "pattern": "^[a-z][0-9a-z]*(-[0-9a-z]+)*$"
    },
    "metachart.interface.boolean": {
      "description": "Boolean flag. A string is rendered as a Go template with the chart context and must produce `true` or `false`",
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "string"
        }
      ]
    },
    "metachart.interface.checksumEntryList": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/definitions/metachart.interface.FQDNitem"
          }
        },
        {
          "enum": ["*"]
        }
      ]
    }
  },
  "properties": {
    "fullnameOverride": {
      "anyOf": [
        {
          "$ref": "#/definitions/metachart.interface.FQDNitem"
        },
        {
          "type": "null"
        }
      ]
    },
    "context": {
      "type": "object",
      "description": "Any content which can be used for config rendering without schema defined by the chart"
    },
    "global": {
      "type": "object",
      "description": "Values shared with sub-charts. `settings` and every root key marked `global: true` in the chart config are merged into the top-level keys of the same name before rendering: local keys win, dictionaries merge recursively, lists are concatenated",
      "properties": {
        "settings": {
          "$ref": "#/properties/settings"
        }
      }
    },
    "settings": {
      "type": "object",
      "properties": {
        "global": {
          "type": "object",
          "properties": {
            "labels": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "annotations": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
